<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:id="@+id/tvGlowny" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="48sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvInfo" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:gravity="center"
        android:layout_marginTop="16dp" android:textSize="18sp" />
    <Button android:id="@+id/btnReset" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Reset" />
</LinearLayout>
